# -----------------------------------------------------------------------------
# Spring Boot Local Development Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to '.env' (which is gitignored) and fill in your actual secrets.
# Spring Boot will automatically load '.env' on startup thanks to spring-dotenv.
# -----------------------------------------------------------------------------

# Database
DATABASE_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password

# SMTP (Gmail)
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_16_digit_app_password

# Authentication
JWT_SECRET=your_supabase_jwt_secret

# Internal Service Communication
INTERNAL_SERVICE_KEY=cypherdon_internal_123
FASTAPI_URL=http://localhost:8000
