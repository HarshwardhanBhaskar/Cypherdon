# ============================================
# Cypherdon Monorepo .gitignore
# ============================================

# ---- Secrets & Environment Variables ----
.env
.env.local
.env.production
.env.*
!.env.example

# ---- Node.js / Next.js ----
node_modules/
.next/
out/
dist/
build/

# ---- Java / Spring Boot ----
target/
*.class
*.jar

# ---- Python ----
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/

# ---- User Uploads / Media ----
uploads/
media/
files/

# ---- Logs & Temp ----
*.log
logs/
tmp/
temp/

# ---- OS Files ----
.DS_Store
Thumbs.db

# ---- IDEs ----
.vscode/
.idea/
*.iml

# ---- Certificates & Keys ----
*.pem
*.key
*.crt
*.p12

# ---- Testing / Caching ----
coverage/
.cache/
pytest_cache/

# ---- Database Dumps ----
*.sql
*.dump
*.bak
