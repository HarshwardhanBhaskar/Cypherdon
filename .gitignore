# ============================================
# Cypherdon Monorepo .gitignore
# ============================================

# ---- Secrets & Environment Variables ----
.env
.env.*
*.env
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ---- Node.js / Next.js ----
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Java / Spring Boot ----
spring-backend/target/
spring-backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
hs_err_pid*

# ---- IDEs ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- OS ----
desktop.ini
ehthumbs.db

# ---- Misc ----
*.log
*.tmp
*.bak
